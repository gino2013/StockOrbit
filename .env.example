FT_USERNAME=
FT_PASSWORD=
# TOTP secret from Firstrade's 2FA setup (not a backup code) — lets login
# complete without waiting for an emailed/texted one-time code.
FT_MFA_SECRET=

# Local dev default is sqlite. In production (Render), set this to the
# Neon Postgres connection string instead.
DATABASE_URL=sqlite:///./stockorbit.db

# --- multi-user (see docs/multi-user-architecture.md) ---
# Required once auth is wired: signs session cookies. >= 32 chars.
# Any long random string locally; use real randomness in production.
APP_SECRET_KEY=
# The account that keeps the FT_* env auto-sync. Both unset -> local dev
# auto-creates owner@localhost / owner.
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=
# Fernet key for per-user Firstrade credential storage. Unset -> the
# "connect Firstrade" feature is disabled. Keep separate from APP_SECRET_KEY.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FT_CREDENTIAL_KEY=
# Sends email-verification and password-reset mail. SMTP_HOST unset ->
# mailer just logs the message (registration still works). Port defaults
# to 587, SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
