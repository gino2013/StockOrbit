FT_USERNAME=
FT_PASSWORD=
# TOTP secret from Firstrade's 2FA setup (not a backup code) — lets login
# complete without waiting for an emailed/texted one-time code.
FT_MFA_SECRET=

# Local dev default is sqlite. In production (Render), set this to the
# Neon Postgres connection string instead.
DATABASE_URL=sqlite:///./stockorbit.db
